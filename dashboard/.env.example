# Copy this file to .env.local and supply your own credentials.
# Keep these server-side; do not use NEXT_PUBLIC_ or VITE_ prefixes.
GMGN_API_KEY=

# Optional: enables X discussion samples when the token has the required access.
X_BEARER_TOKEN=

# Optional: the tracked-address column and the on-chain market cap both read
# straight off the chain. Robinhood and Arc work without any of these — each has
# a public endpoint built in, and the variable below only overrides it. Supply an
# endpoint for whichever of the other chains you want those two to work on; a
# chain left blank says so on screen rather than guessing at an endpoint whose
# rate limit would turn into silent gaps. Solana is not covered — it is not an
# EVM chain, so it has neither a balance sweep nor a pool read here.
ETH_RPC_URL=
BSC_RPC_URL=
BASE_RPC_URL=
ROBINHOOD_RPC_URL=
ARC_RPC_URL=

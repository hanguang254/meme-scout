# Copy this file to .env.local and supply your own credentials.
# Keep these server-side; do not use NEXT_PUBLIC_ or VITE_ prefixes.
GMGN_API_KEY=

# Optional: enables X discussion samples when the token has the required access.
X_BEARER_TOKEN=

# Optional: the tracked-address column reads balances straight off the chain.
# Robinhood works without any of these. Supply an endpoint for whichever of the
# other chains you want the column to work on; a chain left blank says so in the
# column rather than guessing at a public endpoint whose rate limit would turn
# into silent gaps in the counts. Solana is not covered — it is not an EVM chain.
ETH_RPC_URL=
BSC_RPC_URL=
BASE_RPC_URL=
